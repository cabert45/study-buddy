ANTHROPIC_API_KEY=sk-ant-...
PORT=3000

# Voix ElevenLabs (facultatif). Sans cle, l app garde la voix de l appareil.
# La cle reste sur le serveur: l app ne la voit jamais.
ELEVENLABS_API_KEY=sk_...
# La voix par defaut (choix "Automatique" dans Reglages). Identifiant pris
# sur elevenlabs.io > Voices, ou via GET /api/tts/voices une fois la cle posee.
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 (rapide, ~2x moins cher) ou eleven_multilingual_v2 (qualite max)
ELEVENLABS_MODEL=eleven_flash_v2_5
